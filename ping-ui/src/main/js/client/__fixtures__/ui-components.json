{
  "type": "app",
  "id": "ping.app",
  "children": [
    {
      "type": "page",
      "id": "user",
      "children": [
        {
          "type": "function",
          "id": "list",
          "properties": {
            "operationId": "findUsers",
            "method": "GET",
            "path": "/v1/system/users",
            "parameters": [
              {
                "name": "name",
                "in": "query",
                "required": false,
                "schema": {
                  "type": "string"
                }
              },
              {
                "name": "account",
                "in": "query",
                "required": false,
                "schema": {
                  "type": "string"
                }
              },
              {
                "name": "state",
                "in": "query",
                "required": false,
                "schema": {
                  "type": "string",
                  "enum": [
                    "disable",
                    "enable"
                  ]
                }
              },
              {
                "name": "gender",
                "in": "query",
                "required": false,
                "schema": {
                  "type": "string",
                  "description": "用户性别",
                  "enum": [
                    "man",
                    "woman",
                    "unknown"
                  ]
                }
              },
              {
                "name": "offset",
                "in": "query",
                "description": "基于从1开始的分页 (1..N)",
                "schema": {
                  "type": "integer",
                  "format": "int32",
                  "default": 1
                }
              },
              {
                "name": "size",
                "in": "query",
                "description": "每页大小",
                "schema": {
                  "type": "integer",
                  "format": "int32",
                  "default": 10
                }
              },
              {
                "name": "sort",
                "in": "query",
                "description": "指定排序字段, 格式为: property,(asc|desc)",
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "String",
                    "example": "id"
                  }
                }
              }
            ],
            "responses": {
              "200": {
                "description": "OK",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "empty": {
                          "type": "boolean",
                          "description": "Content是否为空",
                          "example": true
                        },
                        "content": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "format": "int64",
                                "description": "用户ID"
                              },
                              "name": {
                                "type": "string",
                                "description": "用户昵称"
                              },
                              "gender": {
                                "type": "string",
                                "description": "用户性别",
                                "enum": [
                                  "man",
                                  "woman",
                                  "unknown"
                                ]
                              },
                              "remark": {
                                "type": "string",
                                "description": "用户备注"
                              },
                              "account": {}
                            }
                          }
                        },
                        "offset": {
                          "type": "integer",
                          "format": "int64",
                          "description": "页码偏移量",
                          "example": 1
                        },
                        "total": {
                          "type": "integer",
                          "format": "int64",
                          "description": "总页数",
                          "example": 100
                        },
                        "next": {
                          "type": "boolean",
                          "description": "是否存在后续数据",
                          "example": true
                        },
                        "limit": {
                          "type": "integer",
                          "format": "int32",
                          "description": "每页大小",
                          "example": 10
                        },
                        "first": {
                          "type": "boolean",
                          "description": "是否为第一页数据",
                          "example": true
                        }
                      }
                    }
                  }
                }
              }
            },
            "route": "user/list"
          }
        },
        {
          "type": "function",
          "id": "status",
          "properties": {
            "operationId": "accountStatusSetting",
            "method": "PATCH",
            "path": "/v1/system/users/{id}/account",
            "parameters": [
              {
                "name": "id",
                "in": "path",
                "required": true,
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            ],
            "requestBody": {
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "state": {
                        "type": "string",
                        "enum": [
                          "disable",
                          "enable"
                        ]
                      }
                    },
                    "required": [
                      "state"
                    ]
                  }
                }
              },
              "required": true
            },
            "responses": {
              "204": {
                "description": "No Content"
              }
            },
            "route": "user/status"
          }
        },
        {
          "type": "function",
          "id": "current",
          "properties": {
            "operationId": "currentAuthentication",
            "method": "GET",
            "path": "/v1/system/authentications/current",
            "responses": {
              "200": {
                "description": "OK",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "account": {
                          "type": "string"
                        },
                        "nick_name": {
                          "type": "string"
                        },
                        "login_date": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            },
            "route": "user/current"
          }
        }
      ]
    }
  ]
}
