{
  "type": "field",
  "name": "表单字段",
  "category": "form",
  "description": "可输入可选择的数据项，是入参 schema 到控件的映射单元",
  "children": [],
  "properties": [
    {
      "name": "name",
      "type": "string",
      "required": true,
      "description": "字段名，对应入参或出参 schema 中的键"
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "description": "标签，缺省回落 name"
    },
    {
      "name": "widget",
      "type": "string",
      "required": false,
      "description": "控件：input/textarea/select/radio/checkbox/switch/date_picker/date_range/upload/number/rate/slider"
    },
    {
      "name": "required",
      "type": "boolean",
      "required": false,
      "description": "必填"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "只读或禁用"
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "description": "占位提示"
    },
    {
      "name": "default",
      "type": "any",
      "required": false,
      "description": "默认值"
    },
    {
      "name": "options",
      "type": "array",
      "required": false,
      "description": "选项数组，select/radio/checkbox 必需"
    },
    {
      "name": "multiple",
      "type": "boolean",
      "required": false,
      "description": "多选"
    },
    {
      "name": "pattern",
      "type": "string",
      "required": false,
      "description": "正则校验"
    },
    {
      "name": "min_length",
      "type": "integer",
      "required": false,
      "description": "最小长度"
    },
    {
      "name": "max_length",
      "type": "integer",
      "required": false,
      "description": "最大长度"
    },
    {
      "name": "min",
      "type": "number",
      "required": false,
      "description": "最小值"
    },
    {
      "name": "max",
      "type": "number",
      "required": false,
      "description": "最大值"
    },
    {
      "name": "col_span",
      "type": "integer",
      "required": false,
      "description": "跨越的栅格列数 1-3"
    }
  ]
