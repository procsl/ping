{
  "type": "form",
  "name": "表单",
  "category": "form",
  "description": "一组字段与一组动作的收集与提交单元",
  "children": [
    "field",
    "form_action"
  ],
  "properties": [
    {
      "name": "api",
      "type": "object",
      "required": false,
      "description": "提交接口；request.schema 为表单字段集合"
    },
    {
      "name": "mode",
      "type": "string",
      "required": false,
      "description": "create 或 edit；edit 时按行主键回填"
    },
    {
      "name": "cols",
      "type": "integer",
      "required": false,
      "description": "字段栅格列数 1-3，默认 1"
    },
    {
      "name": "label_width",
      "type": "string",
      "required": false,
      "description": "标签宽度"
    }
  ]
}
